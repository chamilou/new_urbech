FROM node:20-bookworm-slim
WORKDIR /app

RUN apt-get update -y \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Only prisma schema + migrations are needed
COPY prisma ./prisma

# Create minimal node project and pin Prisma versions
RUN npm init -y \
 && npm install --save-dev prisma@5.4.2 \
 && npm install @prisma/client@5.4.2

# Run prisma from local install (prevents npx fetching latest)
CMD ["./node_modules/.bin/prisma", "migrate", "deploy"]
