# Database Configuration
POSTGRES_DB=myshop
POSTGRES_USER=myshop_user
POSTGRES_PASSWORD=replace-with-strong-database-password
DATABASE_URL=postgresql://myshop_user:replace-with-strong-database-password@localhost:5432/myshop

# Backend Configuration
SECRET_KEY=replace-with-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://frontend:3000
FRONTEND_RESET_URL=http://localhost:3000/reset-password

# SMTP Configuration
SMTP_SERVER=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=replace-me@example.com
SMTP_PASSWORD=replace-me
FROM_EMAIL=replace-me@example.com

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost/api

# Application
NODE_ENV=development
